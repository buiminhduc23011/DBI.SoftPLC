<Window x:Class="DBI.Controller.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
        xmlns:adcontrols="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:roslynpad="clr-namespace:RoslynPad.Editor;assembly=RoslynPad.Editor.Windows"
        xmlns:vm="clr-namespace:DBI.Controller.Studio.Core.ViewModels;assembly=DBI.Controller.Studio.Core"
        xmlns:behaviors="clr-namespace:DBI.Controller.Studio.Behaviors"
        xmlns:converters="clr-namespace:DBI.Controller.Studio.Converters"
        Title="DBI.Studio - Soft PLC Engineering"
        Height="850" Width="1360"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding CompileCommand}" />
        <KeyBinding Key="F5" Command="{Binding DeployCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="BrushFromKey" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="LogEntryTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,1">
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonospaceText}"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource LabelText}" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{Binding BrushKey, Converter={StaticResource BrushFromKey}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectTreeViewModel}">
            <TreeView ItemsSource="{Binding Roots}"
                      behaviors:ProjectTreeBehaviors.SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                      behaviors:ProjectTreeBehaviors.ActivateTarget="{Binding}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="4,3">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding StatusGlyph}"
                                       Foreground="{Binding StatusColorKey, Converter={StaticResource BrushFromKey}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InspectorViewModel}">
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Properties">
                    <DataGrid ItemsSource="{Binding Properties}" Style="{StaticResource FlatDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Binding="{Binding Name}"
                                                Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Information">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Clear log" HorizontalAlignment="Left"
                                Margin="6" Style="{StaticResource FlatButton}"
                                Command="{Binding ClearInformationCommand}" />
                        <ListBox ItemsSource="{Binding Information}" Background="{DynamicResource CardBg}"
                                 BorderThickness="0" ItemTemplate="{StaticResource LogEntryTemplate}" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Clear log" HorizontalAlignment="Left"
                                Margin="6" Style="{StaticResource FlatButton}"
                                Command="{Binding ClearDiagnosticsCommand}" />
                        <ListBox ItemsSource="{Binding Diagnostics}" Background="{DynamicResource CardBg}"
                                 BorderThickness="0" ItemTemplate="{StaticResource LogEntryTemplate}" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TaskCardsViewModel}">
            <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Task 12.4 — card Instructions chỉ hiện khi document active là code editor -->
                    <TextBlock Text="Instructions" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"
                               Visibility="{Binding ShowInstructions, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Instructions}" Margin="0,0,0,16"
                                  Visibility="{Binding ShowInstructions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        ToolTip="Click to insert snippet"
                                        Command="{Binding DataContext.InsertInstructionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Task 12.2 — Device Tags: tag đã khai theo device, ● đã map / ○ chưa -->
                    <TextBlock Text="Device Tags" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding DeviceTags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button ToolTip="Kéo vào Tag Table / Watch Table / code editor, hoặc double-click để chèn tham chiếu IO.TenTag"
                                        behaviors:TagDragDropBehaviors.DragSource="True"
                                        Command="{Binding DataContext.InsertDeviceTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MapGlyph}" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource SuccessColor}" />
                                        <TextBlock Text="{Binding Display}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CodeEditorViewModel}">
            <!-- Task 12.3 — drop target: kéo tag từ Toolbox vào editor chèn IO.TenTag tại caret -->
            <Border BorderThickness="2" BorderBrush="Transparent"
                    behaviors:TagDragDropBehaviors.DropTarget="True">
                <roslynpad:RoslynCodeEditor behaviors:RoslynCodeEditorBehaviors.EnableRoslyn="True"
                                            behaviors:RoslynCodeEditorBehaviors.EnableOverlay="True"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            ShowLineNumbers="True"
                                            Background="{DynamicResource CardBg}"
                                            Foreground="{DynamicResource TextPrimary}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TagTableViewModel}">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="+ Add" Style="{StaticResource FlatButton}"
                            Command="{Binding AddRowCommand}" />
                    <Button Content="Delete" Style="{StaticResource FlatButton}"
                            Command="{Binding DeleteRowCommand}" />
                </StackPanel>

                <!-- Task 12.3 — drop target: kéo device tag từ Toolbox vào đây để map -->
                <Border BorderThickness="2" BorderBrush="Transparent"
                        behaviors:TagDragDropBehaviors.DropTarget="True">
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              Style="{StaticResource FlatDataGrid}" AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="180">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Name" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnNotifyDataErrors="True" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridComboBoxColumn Header="Type" Width="90"
                                                    SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <DataGridComboBoxColumn Header="Direction" Width="110"
                                                    SelectedItemBinding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <DataGridComboBoxColumn Header="Device" Width="160"
                                                    SelectedItemBinding="{Binding Device, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                    ItemsSource="{Binding DataContext.AvailableDevices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <DataGridTextColumn Header="Address" Width="140">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Address" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnNotifyDataErrors="True" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Comment" Width="*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Comment" UpdateSourceTrigger="PropertyChanged" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeviceConfigurationViewModel}">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Width="170" ItemsSource="{Binding DriverCatalog}" SelectedItem="{Binding SelectedDriver}" DisplayMemberPath="DisplayName" Margin="0,0,6,0" />
                    <TextBox Width="150" Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                    <Button Content="+ Add Device" Style="{StaticResource FlatButton}" Command="{Binding AddDeviceCommand}" />
                    <Button Content="+ Add Simulation" Style="{StaticResource FlatButton}" Command="{Binding AddSimulationCommand}" />
                    <Button Content="Delete" Style="{StaticResource FlatButton}" Command="{Binding DeleteSelectedCommand}" />
                    <Button Content="Test Connection" Style="{StaticResource FlatButton}" Margin="12,0,0,0"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBool}}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource FlatDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverType}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="Settings" Binding="{Binding SettingsSummary}" Width="120" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                 Fill="{Binding StatusColorKey, Converter={StaticResource BrushFromKey}}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="{Binding StatusDetail}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding Settings}" AutoGenerateColumns="False" Height="130" Margin="0,8,0,0" CanUserAddRows="False" Style="{StaticResource FlatDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Setting" Binding="{Binding Label}" IsReadOnly="True" Width="180" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WatchTableViewModel}">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Monitor" Style="{StaticResource FlatButton}" Command="{Binding ToggleMonitoringCommand}" />
                    <ComboBox Width="200" Margin="6,0,0,0"
                              ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTagName}"
                              ToolTip="Chọn tag để thêm vào bảng watch" />
                    <Button Content="+ Add" Style="{StaticResource FlatButton}" Command="{Binding AddSelectedTagCommand}" />
                    <Button Content="Remove" Style="{StaticResource FlatButton}" Command="{Binding RemoveSelectedCommand}"
                            CommandParameter="{Binding SelectedRow, Mode=OneWay}" Margin="6,0,0,0" />
                </StackPanel>
                <!-- Task 12.3 — drop target: kéo device tag đã map từ Toolbox vào đây để watch -->
                <Border BorderThickness="2" BorderBrush="Transparent"
                        behaviors:TagDragDropBehaviors.DropTarget="True">
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource FlatDataGrid}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsForced}" Value="True">
                                    <Setter Property="Background" Value="#33C72C3B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tag" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔒" Visibility="{Binding IsForced, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="{Binding ForcedToolTip}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" IsReadOnly="True" Width="70" />
                        <DataGridTemplateColumn Header="Value" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️" Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Mất kết nối — giữ giá trị cuối cùng" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ValueText}"
                                                   Foreground="{Binding ValueBrushKey, Converter={StaticResource BrushFromKey}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat='HH:mm:ss.fff'}" IsReadOnly="True" Width="110" />
                        <DataGridTemplateColumn Header="Modify" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                ToolTip="{Binding ModifyToolTip}">
                                        <TextBox Width="90" Text="{Binding ModifyText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanModify}" />
                                        <Button Content="Apply" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ModifyValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ForceTableViewModel}">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource DangerColor}" FontWeight="Bold" VerticalAlignment="Center" />
                    <ComboBox Width="170" Margin="12,0,0,0"
                              ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTagName}"
                              ToolTip="Tag cần force" />
                    <TextBox Width="90" Text="{Binding NewValueText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Giá trị force (true/false, số...)" />
                    <Button Content="Force" Style="{StaticResource AccentButton}" Command="{Binding ApplyForceCommand}"
                            ToolTip="Ghi đè giá trị tag liên tục — phải qua xác nhận an toàn" />
                    <Button Content="Refresh" Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                    <Button Content="⛔ CLEAR ALL FORCES" Style="{StaticResource AccentButton}" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource FlatDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="🔒 Tag" Binding="{Binding TagName}" IsReadOnly="True" Width="240" />
                        <DataGridTextColumn Header="Force value" Binding="{Binding ValueText}" IsReadOnly="True" Width="140" />
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="Clear" Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GeneratedCodeViewModel}">
            <DockPanel Margin="6">
                <Border DockPanel.Dock="Top" Background="{DynamicResource WarningColor}" Padding="8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding BannerMessage}" Foreground="White" TextWrapping="Wrap" />
                </Border>
                <avalonedit:TextEditor Text="{Binding Text}" IsReadOnly="True"
                                       SyntaxHighlighting="C#"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       ShowLineNumbers="True"
                                       Background="{DynamicResource CardBg}"
                                       Foreground="{DynamicResource TextPrimary}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New project..." Command="{Binding NewProjectCommand}" />
                <MenuItem Header="Open project..." Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="Save all" Command="{Binding SaveAllCommand}" />
                <MenuItem Header="Close project" Command="{Binding CloseProjectCommand}" />
            </MenuItem>
            <MenuItem Header="_Online">
                <MenuItem Header="Build" Command="{Binding CompileCommand}" IsEnabled="{Binding CanCompile}" />
                <MenuItem Header="Deploy to Runtime" Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}" />
                <Separator />
                <MenuItem Header="Start" Command="{Binding StartRuntimeCommand}" IsEnabled="{Binding CanStart}" />
                <MenuItem Header="Stop" Command="{Binding StopRuntimeCommand}" IsEnabled="{Binding CanStop}" />
                <MenuItem Header="Reset" Command="{Binding ResetRuntimeCommand}" IsEnabled="{Binding CanReset}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}" />
                <Separator />
                <MenuItem Header="Reset layout" Command="{Binding ResetLayoutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,2" Padding="6,5">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Command="{Binding NewProjectCommand}" ToolTip="New project">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="New" /></StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenProjectCommand}" ToolTip="Open project">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding SaveAllCommand}" ToolTip="Save all">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Save" /></StackPanel>
                </Button>
                <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource BorderColor}" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding CompileCommand}" IsEnabled="{Binding CanCompile}" ToolTip="Build (Ctrl+Shift+B)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Build" /></StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}" ToolTip="Deploy (F5)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Deploy" /></StackPanel>
                </Button>
                <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource BorderColor}" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding StartRuntimeCommand}" IsEnabled="{Binding CanStart}" ToolTip="Start Runtime">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Start" /></StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding StopRuntimeCommand}" IsEnabled="{Binding CanStop}" ToolTip="Stop Runtime">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding ResetRuntimeCommand}" IsEnabled="{Binding CanReset}" ToolTip="Reset Runtime">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Reset" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,2,0,0" Padding="8,4">
            <Grid DataContext="{Binding StatusBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="8,2" Margin="0,0,10,0"
                        Background="{Binding StateBrushKey, Converter={StaticResource BrushFromKey}}">
                    <TextBlock Text="{Binding StateLabel}" Foreground="White"
                               FontWeight="SemiBold" FontSize="11" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding MetricsSummary}"
                           Style="{StaticResource MonospaceText}" FontSize="11" />

                <TextBlock Grid.Column="2" Text="{Binding FaultMessage}" Margin="16,0"
                           Style="{StaticResource LabelText}" FontSize="11"
                           Foreground="{DynamicResource DangerColor}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Task 11.4 — force đang bật thì KHÔNG được phép bỏ sót -->
                <Border Grid.Column="3" Padding="8,2" Margin="0,0,10,0"
                        Background="{DynamicResource DangerColor}"
                        Visibility="{Binding DataContext.HasActiveForces, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Force ghi đè tín hiệu thật. Mở Force Table để gỡ.">
                    <TextBlock Text="{Binding DataContext.ForceBanner, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White" FontWeight="Bold" FontSize="11" />
                </Border>

                <TextBlock Grid.Column="4" Style="{StaticResource MutedText}" FontSize="11">
                    <Run Text="{Binding AutoStartIndicator, Mode=OneWay}" />
                    <Run Text=" · Project: " />
                    <Run Text="{Binding ProjectName, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <avalondock:DockingManager x:Name="Docking"
                                   DocumentsSource="{Binding Editors.Documents}"
                                   ActiveContent="{Binding Editors.ActiveDocument, Mode=TwoWay}">
            <avalondock:DockingManager.LayoutItemContainerStyle>
                <Style TargetType="{x:Type adcontrols:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                </Style>
            </avalondock:DockingManager.LayoutItemContainerStyle>

            <avalondock:LayoutRoot>
                <avalondock:LayoutPanel Orientation="Horizontal">
                    <avalondock:LayoutAnchorablePaneGroup DockWidth="260">
                        <avalondock:LayoutAnchorablePane>
                            <avalondock:LayoutAnchorable x:Name="ProjectPane" Title="Project"
                                                         ContentId="ProjectTree"
                                                         CanClose="False" />
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutAnchorablePaneGroup>

                    <avalondock:LayoutPanel Orientation="Vertical">
                        <avalondock:LayoutDocumentPaneGroup>
                            <avalondock:LayoutDocumentPane />
                        </avalondock:LayoutDocumentPaneGroup>

                        <avalondock:LayoutAnchorablePaneGroup DockHeight="180">
                            <avalondock:LayoutAnchorablePane>
