<Window x:Class="DBI.Controller.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="DBI Studio - Industrial Soft PLC Control Center" Height="850" Width="1280" Icon="icon.ico"
        Background="{Binding WindowBg}" Foreground="{Binding TextPrimary}" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar / Header Navigation -->
        <Border Grid.Row="0" Background="{Binding HeaderBg}" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Brand Logo -->
                    <Border Background="#0078D4" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="⚡ DBI STUDIO" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Primary Actions -->
                    <Button Content="🚀 1-Click Save &amp; Deploy" Click="BtnDeploy_Click" Background="#107C41" Margin="0,0,8,0"/>
                    <Button Content="{Binding OnlineStatusText}" Click="BtnToggleOnline_Click" Background="#2B2B2B"/>
                    <Button Content="{Binding ThemeToggleText}" Click="BtnToggleTheme_Click" Background="#5C2D91" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Metrics Dashboard Badges (Right Aligned) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scan Time: " Foreground="{Binding TextSecondary}"/>
                            <TextBlock Text="{Binding ScanTimeMs, StringFormat={}{0:F1}ms}" FontWeight="Bold" Foreground="#0078D4"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Max Scan: " Foreground="{Binding TextSecondary}"/>
                            <TextBlock Text="{Binding MaxScanTimeMs, StringFormat={}{0:F1}ms}" FontWeight="Bold" Foreground="#D13438"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Jitter: " Foreground="{Binding TextSecondary}"/>
                            <TextBlock Text="{Binding JitterMs, StringFormat={}{0:F1}ms}" FontWeight="Bold" Foreground="#B4009E"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace Area -->
        <TabControl Grid.Row="1" Background="{Binding WindowBg}" BorderBrush="{Binding BorderColor}" Foreground="{Binding TextPrimary}" Margin="8">
            
            <!-- TAB 1: C# CODE EDITOR & TIA PORTAL LIVE DEBUGGER -->
            <TabItem Header="💻 C# Code Editor &amp; Live Debugger">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- AvalonEdit Code Editor -->
                        <Border Grid.Column="0" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                            <avalonEdit:TextEditor x:Name="CodeEditor" 
                                                   FontFamily="Consolas" 
                                                   FontSize="14.5" 
                                                   ShowLineNumbers="True" 
                                                   Background="{Binding CardBg}" 
                                                   Foreground="{Binding TextPrimary}"/>
                        </Border>

                        <!-- TIA Portal Live Monitoring Glasses Panel -->
                        <Border Grid.Column="1" Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="👓 TIA Portal Live Monitor" FontWeight="Bold" FontSize="15" Foreground="#0078D4"/>
                                    <TextBlock Text="Inline TRUE/FALSE Value Overlay Stream" FontSize="11" Foreground="{Binding TextSecondary}"/>
                                    <Separator Background="{Binding BorderColor}" Margin="0,8,0,0"/>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TagMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding DataContext.WindowBg, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="{Binding CSharpProperty}" FontWeight="Bold" Foreground="#0078D4" FontSize="13"/>
                                                            <TextBlock Text="{Binding HardwareTag}" FontSize="11" Foreground="{Binding DataContext.TextSecondary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </StackPanel>
                                                        
                                                        <Border DockPanel.Dock="Right" Background="{Binding ValueBadgeColor}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CurrentValue}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                                        </Border>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Compiler Output & Console Log Window -->
                    <Border Grid.Row="1" Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="12">
                        <DockPanel>
                            <TextBlock Text="📋 Output &amp; Diagnostics Console Log" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding CompilerOutput}" Background="Transparent" Foreground="{Binding TextPrimary}" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: DRAG & DROP TAG MAPPER -->
            <TabItem Header="🔀 Tag Mapper">
                <Grid Margin="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="🔀 Drag-and-Drop Hardware Tag to C# IO Mapping" FontSize="18" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text="Map physical PLC/Protocol registers directly to C# ControllerProgram IO Properties." Foreground="{Binding TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding TagMappings}" AutoGenerateColumns="False" Background="{Binding CardBg}" Foreground="{Binding TextPrimary}" RowBackground="{Binding WindowBg}" AlternatingRowBackground="{Binding CardBg}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding BorderColor}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="C# IO Property" Binding="{Binding CSharpProperty}" Width="*"/>
                                <DataGridTextColumn Header="Connected Device" Binding="{Binding DeviceName}" Width="*"/>
                                <DataGridTextColumn Header="Hardware Tag Address" Binding="{Binding HardwareTag}" Width="*"/>
                                <DataGridTextColumn Header="Live State" Binding="{Binding CurrentValue}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: DEVICE MANAGER -->
            <TabItem Header="🔌 Device Manager">
                <Grid Margin="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔌 Industrial Device &amp; Driver Connections" FontSize="18" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Content="+ Add New Hardware Device" Background="#107C41"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" Background="{Binding CardBg}" Foreground="{Binding TextPrimary}" RowBackground="{Binding WindowBg}" AlternatingRowBackground="{Binding CardBg}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding BorderColor}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Driver Type (DBI.Drivers)" Binding="{Binding Type}" Width="1.5*"/>
                                <DataGridTextColumn Header="Connection Info" Binding="{Binding ConnectionInfo}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            
        </TabControl>

        <!-- Bottom App Status Bar -->
        <StatusBar Grid.Row="2" Background="#0078D4" Foreground="#FFFFFF" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="DBI.Controller Soft PLC Engine: RUNNING | Target: 20ms High-Precision Cycle | Safety Catch: ACTIVE | Status: OK" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
