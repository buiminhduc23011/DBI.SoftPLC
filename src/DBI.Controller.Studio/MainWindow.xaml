<Window x:Class="DBI.Controller.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="DBI Studio - Industrial Soft PLC Control Center" Height="800" Width="1200"
        Background="#1E1E1E" Foreground="#CCCCCC" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="⚡ DBI STUDIO" FontSize="18" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="🚀 1-Click Save &amp; Deploy" Click="BtnDeploy_Click" Background="#0E639C"/>
                    <Button Content="{Binding OnlineStatusText}" Click="BtnToggleOnline_Click" Background="#27272D"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Scan Time: " VerticalAlignment="Center" Foreground="#AAAAAA"/>
                    <TextBlock Text="{Binding ScanTimeMs, StringFormat={}{0:F1}ms}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,0,15,0"/>

                    <TextBlock Text="Max Scan: " VerticalAlignment="Center" Foreground="#AAAAAA"/>
                    <TextBlock Text="{Binding MaxScanTimeMs, StringFormat={}{0:F1}ms}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#DCDCAA" Margin="0,0,15,0"/>

                    <TextBlock Text="Jitter: " VerticalAlignment="Center" Foreground="#AAAAAA"/>
                    <TextBlock Text="{Binding JitterMs, StringFormat={}{0:F1}ms}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CE9178"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46" Foreground="#FFFFFF">
            
            <!-- TAB 1: C# CODE EDITOR & TIA PORTAL LIVE DEBUGGER -->
            <TabItem Header="💻 C# Code Editor &amp; Live Debugger">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- AvalonEdit Code Editor -->
                        <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <avalonEdit:TextEditor x:Name="CodeEditor" 
                                                   FontFamily="Consolas" 
                                                   FontSize="14" 
                                                   ShowLineNumbers="True" 
                                                   Background="#1E1E1E" 
                                                   Foreground="#D4D4D4"/>
                        </Border>

                        <!-- TIA Portal Live Monitoring Glasses Panel -->
                        <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="👓 Live Values (Glasses Mode)" FontWeight="Bold" FontSize="14" Foreground="#4EC9B0" Margin="0,0,0,10"/>
                                <Separator Background="#3F3F46" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding TagMappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding CSharpProperty}" FontWeight="Bold" Foreground="#9CDCFE"/>
                                                        <TextBlock Text="{Binding HardwareTag}" FontSize="11" Foreground="#808080"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CurrentValue}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4EC9B0" FontSize="13"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Compiler Output Window -->
                    <Border Grid.Row="1" Background="#181818" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,10,0,0" Padding="8">
                        <DockPanel>
                            <TextBlock Text="📋 Output &amp; Diagnostics Log" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CompilerOutput}" Background="Transparent" Foreground="#DCDCAA" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: DRAG & DROP TAG MAPPER -->
            <TabItem Header="🔀 Tag Mapper">
                <Grid Margin="10">
                    <DockPanel>
                        <TextBlock Text="🔀 Drag-and-Drop Hardware Tag to C# IO Mapping" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding TagMappings}" AutoGenerateColumns="False" Background="#252526" Foreground="#FFFFFF" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="C# IO Property" Binding="{Binding CSharpProperty}" Width="*"/>
                                <DataGridTextColumn Header="Connected Device" Binding="{Binding DeviceName}" Width="*"/>
                                <DataGridTextColumn Header="Hardware Tag Address" Binding="{Binding HardwareTag}" Width="*"/>
                                <DataGridTextColumn Header="Live Value" Binding="{Binding CurrentValue}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: DEVICE MANAGER -->
            <TabItem Header="🔌 Device Manager">
                <Grid Margin="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🔌 Industrial Device &amp; Driver Connections" FontSize="16" FontWeight="Bold" Foreground="#569CD6" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Content="+ Add New Device"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" Background="#252526" Foreground="#FFFFFF" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Driver Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="Connection Info" Binding="{Binding ConnectionInfo}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            
        </TabControl>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="#FFFFFF">
            <StatusBarItem>
                <TextBlock Text="DBI.Controller Soft PLC Engine: RUNNING | Scan Cycle: 20ms | Status: OK"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
