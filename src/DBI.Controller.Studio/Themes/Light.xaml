<!--
    Bảng màu Light — phong cách industrial phẳng, giữ nguyên như commit 83518a4 / 5c0a02d.
    Mọi brush đều dùng qua {DynamicResource}, KHÔNG phải {Binding}: spike AvalonDock xác nhận
    theme token dạng string binding trên ViewModel không theme được panel của AvalonDock.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"      Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBg"      Color="#E8E8E8" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#555555" />
    <SolidColorBrush x:Key="BorderColor"   Color="#CCCCCC" />
    <SolidColorBrush x:Key="AccentColor"   Color="#005A9E" />

    <!-- Màu trạng thái máy — giống nhau ở cả hai theme để kỹ sư không phải học lại. -->
    <SolidColorBrush x:Key="SuccessColor"  Color="#107C41" />
    <SolidColorBrush x:Key="DangerColor"   Color="#C72C3B" />
    <SolidColorBrush x:Key="WarningColor"  Color="#B8860B" />
    <SolidColorBrush x:Key="IdleColor"     Color="#808080" />

    <SolidColorBrush x:Key="SelectionBg"   Color="#CCE4F7" />
    <SolidColorBrush x:Key="HoverBg"       Color="#E5F1FB" />

</ResourceDictionary>
