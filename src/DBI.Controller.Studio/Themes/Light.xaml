<!--
    Bảng màu Light — phong cách industrial phẳng, giữ nguyên như commit 83518a4 / 5c0a02d.
    Mọi brush đều dùng qua {DynamicResource}, KHÔNG phải {Binding}: spike AvalonDock xác nhận
    theme token dạng string binding trên ViewModel không theme được panel của AvalonDock.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"      Color="#EEF2F6" />
    <SolidColorBrush x:Key="CardBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBg"      Color="#DCE3EA" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#182433" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5D6C7D" />
    <SolidColorBrush x:Key="BorderColor"   Color="#C2CDD9" />
    <SolidColorBrush x:Key="AccentColor"   Color="#1E5FBF" />

    <!-- Màu trạng thái máy — giống nhau ở cả hai theme để kỹ sư không phải học lại. -->
    <SolidColorBrush x:Key="SuccessColor"  Color="#247A50" />
    <SolidColorBrush x:Key="DangerColor"   Color="#BF3A30" />
    <SolidColorBrush x:Key="WarningColor"  Color="#B86E16" />
    <SolidColorBrush x:Key="IdleColor"     Color="#7F8B99" />

    <SolidColorBrush x:Key="SelectionBg"   Color="#E6EEF9" />
    <SolidColorBrush x:Key="HoverBg"       Color="#E3EBF7" />

</ResourceDictionary>
