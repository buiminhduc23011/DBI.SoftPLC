<!--
    Bảng màu Light theo Visual Studio. Cùng bộ key với Dark.xaml — thiếu một key là chỗ đó
    trống lúc runtime (test canh: ThemeDictionaryParityTests). Mọi brush dùng qua
    {DynamicResource}, KHÔNG {Binding}: spike AvalonDock xác nhận theme token dạng string
    binding không theme được panel của AvalonDock.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"      Color="#EEEEF2" />
    <SolidColorBrush x:Key="CardBg"        Color="#F5F5F5" />
    <SolidColorBrush x:Key="HeaderBg"      Color="#DCE3EA" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#1E1E1E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5D6C7D" />
    <SolidColorBrush x:Key="BorderColor"   Color="#C2CDD9" />
    <SolidColorBrush x:Key="AccentColor"   Color="#0F6CBD" />

    <!-- Màu trạng thái máy — giống nhau ở cả hai theme để kỹ sư không phải học lại. -->
    <SolidColorBrush x:Key="SuccessColor"  Color="#247A50" />
    <SolidColorBrush x:Key="DangerColor"   Color="#BF3A30" />
    <SolidColorBrush x:Key="WarningColor"  Color="#B86E16" />
    <SolidColorBrush x:Key="IdleColor"     Color="#7F8B99" />
    <!-- Alias của IdleColor: 3 VM (ProjectTree/DeviceConfig/WatchTable) đã tham chiếu tên này. -->
    <SolidColorBrush x:Key="MutedColor"    Color="#7F8B99" />

    <SolidColorBrush x:Key="SelectionBg"   Color="#BDD8F1" />
    <SolidColorBrush x:Key="HoverBg"       Color="#DCEBFC" />
    <SolidColorBrush x:Key="DisabledText"  Color="#A2A4A5" />

    <!-- Ô nhập focus viền xanh VS; scrollbar/tooltip/menu con bám bảng VS light. -->
    <SolidColorBrush x:Key="InputBorderFocus"    Color="#007ACC" />
    <SolidColorBrush x:Key="ScrollbarBg"         Color="#F5F5F5" />
    <SolidColorBrush x:Key="ScrollbarThumb"      Color="#C1C1C1" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TooltipBg"           Color="#FFFFFE" />
    <SolidColorBrush x:Key="TooltipFg"           Color="#1E1E1E" />
    <SolidColorBrush x:Key="TooltipBorder"       Color="#000000" />
    <SolidColorBrush x:Key="MenuHoverBg"         Color="#DCEBFC" />
    <SolidColorBrush x:Key="SubMenuBg"           Color="#F5F5F5" />
    <SolidColorBrush x:Key="SubMenuBorder"       Color="#C2CDD9" />

    <!-- Nền dòng watch đang bị force: đỏ nhạt trong suốt (đã thay #33C72C3B cứng). -->
    <SolidColorBrush x:Key="ForceRowBg"          Color="#26BF3A30" />
    <!-- Marker ⟨giá trị⟩ live overlay cuối dòng code. -->
    <SolidColorBrush x:Key="OverlayMarkerBrush"  Color="#1E5FBF" />
    <!-- Viền drop-target khi kéo tag từ Toolbox (đã thay #005A9E cứng). -->
    <SolidColorBrush x:Key="TextOnAccent"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="DropHighlightBrush"  Color="#005A9E" />

</ResourceDictionary>
