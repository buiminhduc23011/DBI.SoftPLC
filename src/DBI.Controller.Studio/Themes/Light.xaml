<!--
    Bảng màu Light theo Visual Studio 2022. Cùng bộ key với Dark.xaml — thiếu một key là chỗ đó
    trống lúc runtime (test canh: ThemeDictionaryParityTests). Mọi brush dùng qua
    {DynamicResource}, KHÔNG {Binding}.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"      Color="#F5F5F5" />
    <SolidColorBrush x:Key="CardBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBg"      Color="#EEEEF2" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#1E1E1E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5D6C7D" />
    <SolidColorBrush x:Key="BorderColor"   Color="#D6DBE2" />
    <SolidColorBrush x:Key="AccentColor"   Color="#0078D4" />

    <!-- Màu trạng thái máy — giống nhau ở cả hai theme để kỹ sư không phải học lại. -->
    <SolidColorBrush x:Key="SuccessColor"  Color="#107C41" />
    <SolidColorBrush x:Key="DangerColor"   Color="#C42B1C" />
    <SolidColorBrush x:Key="WarningColor"  Color="#B86E16" />
    <SolidColorBrush x:Key="IdleColor"     Color="#797775" />
    <!-- Alias của IdleColor: 3 VM (ProjectTree/DeviceConfig/WatchTable) đã tham chiếu tên này. -->
    <SolidColorBrush x:Key="MutedColor"    Color="#797775" />

    <SolidColorBrush x:Key="SelectionBg"   Color="#CCE8FF" />
    <SolidColorBrush x:Key="HoverBg"       Color="#E5F3FB" />
    <SolidColorBrush x:Key="DisabledText"  Color="#A19F9D" />

    <!-- Ô nhập focus viền xanh VS; scrollbar/tooltip/menu con bám bảng VS light. -->
    <SolidColorBrush x:Key="InputBorderFocus"    Color="#0078D4" />
    <SolidColorBrush x:Key="ScrollbarBg"         Color="#F5F5F5" />
    <SolidColorBrush x:Key="ScrollbarThumb"      Color="#C1C1C1" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#9E9E9E" />
    <SolidColorBrush x:Key="TooltipBg"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="TooltipFg"           Color="#1E1E1E" />
    <SolidColorBrush x:Key="TooltipBorder"       Color="#CCCCCC" />
    <SolidColorBrush x:Key="MenuHoverBg"         Color="#CCE8FF" />
    <SolidColorBrush x:Key="SubMenuBg"           Color="#FDFCFC" />
    <SolidColorBrush x:Key="SubMenuBorder"       Color="#D0D0D0" />

    <!-- Nền dòng watch đang bị force: đỏ nhạt trong suốt. -->
    <SolidColorBrush x:Key="ForceRowBg"          Color="#26C42B1C" />
    <!-- Marker ⟨giá trị⟩ live overlay cuối dòng code. -->
    <SolidColorBrush x:Key="OverlayMarkerBrush"  Color="#0078D4" />
    <!-- Viền drop-target khi kéo tag từ Toolbox. -->
    <SolidColorBrush x:Key="TextOnAccent"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="DropHighlightBrush"  Color="#0078D4" />

</ResourceDictionary>
