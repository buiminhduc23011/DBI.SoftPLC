<!--
    Bảng màu Dark theo Visual Studio. Cùng bộ key với Light.xaml — đổi theme là swap
    MergedDictionaries, thiếu một key nào thì chỗ đó sẽ trống trơn lúc runtime (test canh:
    ThemeDictionaryParityTests). Mọi brush dùng qua {DynamicResource}, KHÔNG {Binding}.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"      Color="#1F1F1F" />
    <SolidColorBrush x:Key="CardBg"        Color="#252526" />
    <SolidColorBrush x:Key="HeaderBg"      Color="#2D2D30" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#F1F1F1" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0" />
    <SolidColorBrush x:Key="BorderColor"   Color="#3F3F46" />
    <SolidColorBrush x:Key="AccentColor"   Color="#0F6CBD" />

    <!-- Màu trạng thái máy — sáng hơn bản Light một chút để đủ tương phản trên nền tối. -->
    <SolidColorBrush x:Key="SuccessColor"  Color="#16A34A" />
    <SolidColorBrush x:Key="DangerColor"   Color="#E5484D" />
    <SolidColorBrush x:Key="WarningColor"  Color="#D4A017" />
    <SolidColorBrush x:Key="IdleColor"     Color="#808080" />
    <!-- Alias của IdleColor: 3 VM (ProjectTree/DeviceConfig/WatchTable) đã tham chiếu tên này
         từ phase trước nhưng key từng không tồn tại → glyph tra ra Transparent vô hình. -->
    <SolidColorBrush x:Key="MutedColor"    Color="#808080" />

    <SolidColorBrush x:Key="SelectionBg"   Color="#094771" />
    <SolidColorBrush x:Key="HoverBg"       Color="#3E3E40" />
    <SolidColorBrush x:Key="DisabledText"  Color="#656565" />

    <!-- Ô nhập focus viền xanh VS; scrollbar/tooltip/menu con bám bảng VS dark. -->
    <SolidColorBrush x:Key="InputBorderFocus"    Color="#007ACC" />
    <SolidColorBrush x:Key="ScrollbarBg"         Color="#252526" />
    <SolidColorBrush x:Key="ScrollbarThumb"      Color="#424242" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#686868" />
    <SolidColorBrush x:Key="TooltipBg"           Color="#1B1B1A" />
    <SolidColorBrush x:Key="TooltipFg"           Color="#F1F1F1" />
    <SolidColorBrush x:Key="TooltipBorder"       Color="#454545" />
    <SolidColorBrush x:Key="MenuHoverBg"         Color="#3E3E40" />
    <SolidColorBrush x:Key="SubMenuBg"           Color="#1F1F1F" />
    <SolidColorBrush x:Key="SubMenuBorder"       Color="#454545" />

    <!-- Nền dòng watch đang bị force: đỏ nhạt trong suốt trên nền tối (đã thay #33C72C3B cứng). -->
    <SolidColorBrush x:Key="ForceRowBg"          Color="#33C72C3B" />
    <!-- Marker ⟨giá trị⟩ live overlay cuối dòng code. -->
    <SolidColorBrush x:Key="OverlayMarkerBrush"  Color="#3794FF" />
    <!-- Viền drop-target khi kéo tag từ Toolbox (đã thay #005A9E cứng). -->
    <SolidColorBrush x:Key="TextOnAccent"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="DropHighlightBrush"  Color="#005A9E" />

</ResourceDictionary>
