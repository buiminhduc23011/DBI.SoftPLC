<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Ghim version cụ thể: wildcard làm build không tái lập được giữa các máy. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Codicons" Version="6.2.1" />
    <PackageReference Include="RoslynPad.Editor.Windows" Version="5.0.0" />
    <!-- Version ghim ở Directory.Build.props — xem ghi chú NU1608 ở đó. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(DbiRoslynVersion)" />
  </ItemGroup>

  <!--
    ⚠️ ADR-001 — KHÔNG tham chiếu DBI.Controller.Runtime hay Drivers/*.
    Studio nói chuyện với Runtime qua DBI.Controller.Protocol, và driver DLL đóng gói kèm Runtime.
    Nếu thêm lại reference tới Runtime, ranh giới tiến trình chỉ còn là hình thức.

    Core + SDK giữ lại vì cần để BIÊN DỊCH code người dùng (phase-07), không phải để chạy.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DBI.Controller.Core\DBI.Controller.Core.csproj" />
    <ProjectReference Include="..\DBI.Controller.SDK\DBI.Controller.SDK.csproj" />
    <ProjectReference Include="..\DBI.Controller.Protocol\DBI.Controller.Protocol.csproj" />
    <ProjectReference Include="..\DBI.Controller.Studio.Core\DBI.Controller.Studio.Core.csproj" />
    <ProjectReference Include="..\DBI.Controller.Diagnostics\DBI.Controller.Diagnostics.csproj" />
  </ItemGroup>

</Project>
