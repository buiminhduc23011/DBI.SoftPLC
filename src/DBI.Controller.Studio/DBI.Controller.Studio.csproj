<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Version ghim ở Directory.Build.props — xem ghi chú NU1608 ở đó. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(DbiRoslynVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBI.Controller.Core\DBI.Controller.Core.csproj" />
    <ProjectReference Include="..\DBI.Controller.SDK\DBI.Controller.SDK.csproj" />
    <ProjectReference Include="..\DBI.Controller.Studio.Core\DBI.Controller.Studio.Core.csproj" />
    <ProjectReference Include="..\DBI.Controller.Runtime\DBI.Controller.Runtime.csproj" />
    <ProjectReference Include="..\DBI.Controller.Diagnostics\DBI.Controller.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Drivers\DBI.Controller.Driver.Simulation\DBI.Controller.Driver.Simulation.csproj" />
  </ItemGroup>

</Project>
